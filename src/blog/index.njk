---
layout: layouts/base.njk
title: Blog & Makaleler
permalink: /blog/index.html
eleventyExcludeFromCollections: true
---

<div class="pt-32 pb-24 md:pt-40 md:pb-32 bg-warm-200 min-h-screen">
  <div class="container-academy max-w-4xl">
    
    <header class="mb-16 md:mb-24 text-center md:text-left">
      <h1 class="heading-display">Blog & Yazılar</h1>
      <p class="lede mt-6 max-w-2xl">Ruh sağlığı, psikoterapi yaklaşımları ve nöropsikoloji üzerine kaleme aldığım bilgilendirme yazıları.</p>
    </header>

    <div class="grid md:grid-cols-2 gap-8 md:gap-10">
      {% for post in collections.blog | reverse %}
      <article class="bg-white rounded-xl ring-1 ring-clay-400/8 hover:ring-sage-400/40 transition-all duration-300 shadow-soft hover:shadow-paper flex flex-col overflow-hidden group">
        {% if post.data.image %}
        <div class="aspect-[16/9] w-full overflow-hidden bg-clay-400/5">
          <img src="{{ post.data.image }}" alt="{{ post.data.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        </div>
        {% endif %}
        
        <div class="p-6 md:p-8 flex-1 flex flex-col">
          <div class="flex items-center gap-3 text-xs font-mono font-medium tracking-wider2 uppercase text-sage-500 mb-4">
            <time datetime="{{ post.date }}">{{ post.date | date }}</time>
          </div>
          
          <h2 class="font-serif text-2xl text-clay-400 group-hover:text-sage-600 transition-colors mb-3 leading-snug">
            <a href="{{ post.url }}" class="before:absolute before:inset-0">{{ post.data.title }}</a>
          </h2>
          
          <p class="text-clay-200 text-sm leading-relaxed mb-6 flex-1">
            {{ post.data.summary }}
          </p>
          
          <div class="mt-auto flex items-center text-sm font-medium text-sage-500 group-hover:text-sage-600 transition-colors">
            Yazıyı Oku 
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </div>
      </article>
      {% else %}
      <div class="col-span-full py-12 text-center text-clay-200 border border-dashed border-clay-400/20 rounded-xl">
        <p>Henüz yayınlanmış bir yazı bulunmuyor.</p>
      </div>
      {% endfor %}
    </div>

  </div>
</div>
