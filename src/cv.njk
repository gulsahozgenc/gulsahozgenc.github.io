---
layout: layouts/base.njk
title: Özgeçmiş
---

<div class="pt-32 pb-24 md:pt-40 md:pb-32 min-h-screen relative overflow-hidden">
  <div class="container-academy max-w-4xl relative">
    
    <header class="mb-16 md:mb-24 text-center md:text-left">
      <h1 class="heading-display">{{ cv.title }}</h1>
      <p class="lede mt-6 max-w-2xl">{{ cv.lede }}</p>
    </header>

    <div class="space-y-20 md:space-y-28">
      {% for section in cv.sections %}
      <section>
        <h2 class="font-serif text-2xl md:text-3xl text-sage-600 border-b border-clay-400/10 pb-4 mb-10 flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-sage-400"></span>
          {{ section.title }}
        </h2>
        
        <div class="space-y-10">
          {% for item in section.items %}
          <div class="relative pl-6 md:pl-0">
            <!-- Mobile timeline decorations -->
            <div class="absolute left-0 top-3 bottom-[-2.5rem] w-px bg-clay-400/10 md:hidden last:bottom-0"></div>
            <div class="absolute left-[-3.5px] top-3 w-2 h-2 rounded-full bg-sage-300 md:hidden"></div>

            <div class="md:grid md:grid-cols-12 md:gap-8 items-start group">
              <div class="md:col-span-3 pt-1">
                {% if item.year %}
                  <span class="inline-block px-2.5 py-1 rounded bg-warm-200 text-clay-200 
                               font-mono text-[11px] font-medium uppercase tracking-wider2">
                    {{ item.year }}
                  </span>
                {% endif %}
              </div>
              <div class="md:col-span-9 mt-3 md:mt-0 p-5 rounded-lg transition-colors duration-300
                          hover:bg-white hover:ring-1 hover:ring-clay-400/8 hover:shadow-sm">
                <h3 class="font-serif text-xl md:text-2xl text-clay-400 group-hover:text-sage-600 transition-colors">{{ item.title }}</h3>
                <p class="text-sm font-medium text-sage-500 mt-1.5">{{ item.institution }}</p>
                {% if item.description %}
                <p class="text-clay-200 text-sm md:text-base mt-3 leading-relaxed">{{ item.description }}</p>
                {% endif %}
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </section>
      {% endfor %}
    </div>

  </div>
</div>
