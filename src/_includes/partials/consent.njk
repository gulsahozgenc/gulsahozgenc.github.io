<div data-consent-banner class="hidden fixed inset-x-4 bottom-4 md:inset-x-auto md:right-6 md:bottom-6 md:max-w-md z-[60] bg-white rounded-lg shadow-paper ring-1 ring-clay-400/10 p-5" role="dialog" aria-live="polite" aria-label="Çerez tercihleri">
  <p class="font-serif text-lg text-clay-400">Çerezler</p>
  <p class="mt-2 text-sm text-clay-200 leading-relaxed">
    Bu site ziyaret istatistikleri için Google Analytics ve Microsoft Clarity çerezleri kullanır. Bunlar yalnızca izin verirseniz yüklenir; reddederseniz site aynı şekilde çalışır.
    Ayrıntılar <a href="/gizlilik/" class="underline hover:text-sage-500">gizlilik ve çerez politikasında</a>.
  </p>
  <div class="mt-4 flex flex-wrap gap-3">
    <button type="button" data-consent-accept class="btn-primary !py-2 !px-4 text-xs">Kabul ediyorum</button>
    <button type="button" data-consent-reject class="btn-secondary !py-2 !px-4 text-xs">Reddediyorum</button>
  </div>
</div>

<script>
  (function () {
    var KEY = "cerez-onayi";
    var MAX_AGE = 365 * 24 * 60 * 60 * 1000;
    var GA = {{ site.analytics.ga4 | dump | safe }};
    var CLARITY = {{ site.analytics.clarity | dump | safe }};
    var banner = document.querySelector("[data-consent-banner]");
    if (!banner) return;

    function read() {
      try {
        var v = JSON.parse(localStorage.getItem(KEY));
        if (!v || !v.t || Date.now() - v.t > MAX_AGE) return null;
        return v.choice;
      } catch (e) { return null; }
    }
    function write(choice) {
      try { localStorage.setItem(KEY, JSON.stringify({ choice: choice, t: Date.now() })); } catch (e) {}
    }
    function loadAnalytics() {
      if (window.__analyticsLoaded) return;
      window.__analyticsLoaded = true;
      if (GA) {
        var s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag("js", new Date());
        gtag("config", GA, { anonymize_ip: true });
      }
      if (CLARITY) {
        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
          y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", CLARITY);
      }
    }
    function show() { banner.classList.remove("hidden"); }
    function hide() { banner.classList.add("hidden"); }

    banner.querySelector("[data-consent-accept]").addEventListener("click", function () { write("kabul"); hide(); loadAnalytics(); });
    banner.querySelector("[data-consent-reject]").addEventListener("click", function () { write("ret"); hide(); });
    document.querySelectorAll("[data-consent-open]").forEach(function (el) {
      el.addEventListener("click", function (e) { e.preventDefault(); show(); });
    });

    var choice = read();
    if (choice === "kabul") loadAnalytics();
    else if (choice === null) show();
  })();
</script>
