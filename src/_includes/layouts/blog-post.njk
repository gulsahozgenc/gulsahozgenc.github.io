---
layout: layouts/base.njk
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ (summary or site.description) | dump | safe }},
  "datePublished": "{{ page.date.toISOString() }}",
  "inLanguage": "{{ site.lang }}",
  "mainEntityOfPage": "{{ site.url }}{{ page.url }}",
  "author": {
    "@type": "Person",
    "name": {{ site.author | dump | safe }},
    "url": "{{ site.url }}"
  },
  "publisher": {
    "@type": "Person",
    "name": {{ site.author | dump | safe }},
    "url": "{{ site.url }}"
  }
}
</script>

<article class="pt-32 pb-24 md:pt-40 md:pb-32 min-h-screen">
  <div class="container-academy max-w-3xl">
    
    <header class="mb-12">
      <div class="flex items-center gap-4 text-sm text-sage-500 font-medium mb-6">
        <a href="/blog/" class="hover:text-sage-600 flex items-center gap-1 transition-colors">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          Tüm Yazılar
        </a>
        <span class="w-1 h-1 rounded-full bg-clay-400/20"></span>
        <time datetime="{{ page.date }}">{{ page.date | date }}</time>
      </div>
      
      <h1 class="heading-display text-4xl md:text-5xl !leading-tight text-balance">{{ title }}</h1>
      
      {% if summary %}
      <p class="lede mt-6 text-xl">{{ summary }}</p>
      {% endif %}
    </header>

    {% if image %}
    <figure class="mb-12 rounded-xl overflow-hidden ring-1 ring-clay-400/10 shadow-soft">
      <img src="{{ image }}" alt="{{ title }}" class="w-full h-auto object-cover max-h-[500px]" />
    </figure>
    {% endif %}

    <div class="prose prose-sage prose-lg max-w-none text-clay-200 text-justify">
      {{ content | safe }}
    </div>

    <aside class="mt-16 p-8 md:p-10 rounded-lg bg-sage-500/5 ring-1 ring-sage-400/20">
      <h2 class="font-serif text-2xl text-clay-400 mb-3">Destek almayı düşünüyorsanız</h2>
      <p class="text-clay-200 text-sm md:text-base leading-relaxed mb-6">
        Ruh halinizle ilgili bir ön fikir edinmek için kısa tarama testini deneyebilir
        veya doğrudan iletişime geçebilirsiniz.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/#iletisim" class="btn-primary">İletişime Geçin</a>
        <a href="/test/" class="btn-secondary">Kısa Tarama Testi</a>
      </div>
    </aside>

  </div>
</article>
