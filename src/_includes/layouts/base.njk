<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#fdfcfa" />

  <title>{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }} · {{ site.tagline }}{% endif %}</title>

  <meta name="description" content="{{ summary or description or site.description }}" />
  <meta name="author" content="{{ site.author }}" />

  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  {% if noindex %}<meta name="robots" content="noindex, nofollow" />{% endif %}

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="{{ site.locale }}" />
  <meta property="og:site_name" content="{{ site.title }}" />
  <meta property="og:title" content="{{ title or site.title }}" />
  <meta property="og:description" content="{{ summary or description or site.description }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ site.url }}{{ image or '/assets/img/og.jpg' }}" />
  <meta property="og:image:alt" content="{{ title or site.title }}" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title or site.title }}" />
  <meta name="twitter:description" content="{{ description or site.description }}" />
  <meta name="twitter:image" content="{{ site.url }}{{ image or '/assets/img/og.jpg' }}" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": {{ site.author | dump | safe }},
    "jobTitle": {{ site.tagline | dump | safe }},
    "description": {{ site.description | dump | safe }},
    "url": "{{ site.url }}",
    "image": "{{ site.url }}/assets/img/portrait.jpg",
    "email": "mailto:{{ site.email }}",
    "sameAs": [
      {%- set comma = joiner(",") -%}
      {%- for key, link in site.socials %}{% if link %}{{ comma() }}{{ link | dump | safe }}{% endif %}{% endfor -%}
    ],
    "knowsLanguage": "tr"
  }
  </script>

  <link rel="preload" href="/assets/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/playfair-display-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

  <link rel="stylesheet" href="/assets/css/style.css" />

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23488556'/><text x='50%25' y='58%25' text-anchor='middle' font-family='Playfair Display, Georgia, serif' font-style='italic' font-size='20' fill='white'>g</text></svg>" />
</head>
<body class="min-h-screen flex flex-col theme-{{ theme.accent | default('sage') }}">

  {% include "partials/navbar.njk" %}

  <main id="main" class="flex-1">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/consent.njk" %}

  <script>
    (function () {
      var nav = document.querySelector("[data-navbar]");
      if (!nav) return;
      var onScroll = function () {
        if (window.scrollY > 24) nav.classList.add("is-scrolled");
        else nav.classList.remove("is-scrolled");
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      var btn = document.querySelector("[data-menu-toggle]");
      var menu = document.querySelector("[data-mobile-menu]");
      if (btn && menu) {
        btn.addEventListener("click", function () {
          var open = menu.classList.toggle("hidden") === false;
          btn.setAttribute("aria-expanded", String(open));
        });
        menu.querySelectorAll("a").forEach(function (a) {
          a.addEventListener("click", function () { menu.classList.add("hidden"); });
        });
      }

      document.querySelectorAll("[data-map-load]").forEach(function (b) {
        b.addEventListener("click", function () {
          var box = b.closest("[data-map]");
          var tpl = box.querySelector("[data-map-template]");
          box.querySelector("[data-map-placeholder]").remove();
          box.appendChild(tpl.content.cloneNode(true));
        });
      });

      document.querySelectorAll('a[href*="instagram.com"], a[href*="ig.me"]').forEach(function (a) {
        a.addEventListener("click", function () {
          if (typeof gtag === "function") gtag("event", "instagram_click", { link_url: a.href });
        });
      });

      document.querySelectorAll('a[href*="wa.me"], a[href^="tel:"]').forEach(function (a) {
        a.addEventListener("click", function () {
          if (typeof gtag === "function") gtag("event", a.href.indexOf("wa.me") > -1 ? "whatsapp_click" : "phone_click", { link_url: a.href });
        });
      });
    })();
  </script>
</body>
</html>
