---
layout: layouts/base.njk
title: Depresyon Tarama Testi (PHQ-9)
permalink: /test/index.html
description: "PHQ-9 depresyon tarama anketi: dokuz soru, tarayıcınızda hesaplanan ve kaydedilmeyen bir ön değerlendirme. Tanı yerine geçmez."
---
<div class="pt-32 pb-24 min-h-screen bg-warm-200">
  <div class="container-academy max-w-3xl">
    <div class="text-center mb-10">
      <p class="eyebrow flex items-center justify-center gap-3">
        <span class="divider"></span> Öz Değerlendirme <span class="divider"></span>
      </p>
      <h1 class="heading-display mb-4 mt-4 text-4xl md:text-5xl !leading-tight">Depresyon Tarama Testi</h1>
      <p class="lede">Hasta Sağlık Anketi-9 (PHQ-9), depresif belirtileri taramak için dünyada yaygın olarak kullanılan dokuz soruluk bir ankettir. Son iki haftanızı düşünerek yanıtlayın. Sonuç yalnızca tarayıcınızda hesaplanır, hiçbir yere gönderilmez ve kaydedilmez. Bir ön fikir verir; tıbbi tanı ve klinik değerlendirme yerine geçmez.</p>
    </div>

    <div class="bg-white p-6 md:p-10 rounded-lg shadow-soft ring-1 ring-clay-400/5" data-clarity-mask="true">
      <p class="font-medium text-clay-400 mb-6">Son iki hafta içinde aşağıdaki sorunlar sizi ne sıklıkla rahatsız etti?</p>
      <form id="phqForm" class="space-y-6">
        <div id="questionsContainer" class="space-y-6"></div>
        <button type="button" id="calcBtn" class="btn-primary w-full justify-center mt-8 py-3">Sonucu Hesapla</button>
        <p id="formError" class="hidden text-sm text-red-700 text-center"></p>
      </form>

      <div id="resultContainer" class="hidden mt-10 p-8 bg-sage-500/10 rounded-lg text-center border border-sage-500/20">
        <h3 class="font-serif text-2xl text-clay-400 mb-2">Ön Değerlendirme Puanınız</h3>
        <p id="scoreText" class="text-5xl font-light text-sage-600 mb-1">0</p>
        <p class="text-xs text-clay-100 mb-4">0–27 arası</p>
        <p id="resultDescription" class="text-clay-300 font-medium mb-6"></p>
        <div id="safetyNote" class="hidden text-left text-sm text-clay-400 bg-white p-5 rounded-md border border-red-200 mb-6 leading-relaxed">
          <p class="font-medium mb-2">Dokuzuncu soruya verdiğiniz yanıt, kendinize zarar verme düşüncelerine işaret ediyor.</p>
          <p>Lütfen bunu tek başınıza taşımayın. Güvendiğiniz birine söyleyin ve bir ruh sağlığı uzmanına başvurun. Kendinize zarar verme riski hissediyorsanız hemen <strong>112</strong>'yi arayın ya da en yakın acil servise gidin.</p>
        </div>
        <p class="text-sm text-clay-100 italic bg-white/60 p-4 rounded-md">Bu sonuç kesin bir tıbbi tanı değildir. Zorlu bir süreçten geçtiğinizi hissediyorsanız doğru klinik değerlendirme için lütfen profesyonel destek alın.</p>
        <a href="/#iletisim" class="btn-primary mt-6 inline-flex shadow-soft">İletişim Formuna Git</a>
      </div>
    </div>

    <p class="mt-8 text-xs text-clay-100 leading-relaxed text-center">
      PHQ-9: Kroenke K, Spitzer RL, Williams JBW (2001). Pfizer Inc. tarafından geliştirilmiş olup kullanımı için izin gerekmez. Türkçe güvenilirlik çalışması: Sarı YE ve ark. (2016). Yanıtlarınız ve puanınız bu sayfadan dışarı çıkmaz; ayrıntılar <a href="/gizlilik/" class="underline hover:text-sage-500">gizlilik politikasında</a>.
    </p>
  </div>
</div>

<script>
  (function () {
    var questions = [
      "Bir şeyler yaparken çok az ilgi ya da zevk duymak",
      "Kendini üzgün, çökkün ya da umutsuz hissetmek",
      "Uykuya dalmakta ya da uykuyu sürdürmekte güçlük çekmek, ya da çok fazla uyumak",
      "Kendini yorgun hissetmek ya da enerjisinin az olması",
      "İştahsızlık ya da aşırı yeme",
      "Kendini kötü hissetmek; başarısız olduğunu ya da kendini veya ailesini hayal kırıklığına uğrattığını düşünmek",
      "Gazete okumak ya da televizyon izlemek gibi şeylere odaklanmakta güçlük çekmek",
      "Başkalarının fark edebileceği kadar yavaş hareket etmek ya da konuşmak; ya da tam tersi, her zamankinden çok daha hareketli ve huzursuz olmak",
      "Ölmüş olmanın daha iyi olacağını ya da kendine bir şekilde zarar vermeyi düşünmek"
    ];
    var options = [
      { text: "Hiç", score: 0 },
      { text: "Birkaç gün", score: 1 },
      { text: "Günlerin yarısından fazlasında", score: 2 },
      { text: "Hemen hemen her gün", score: 3 }
    ];

    var container = document.getElementById("questionsContainer");
    questions.forEach(function (q, qi) {
      var box = document.createElement("fieldset");
      box.className = "p-5 border border-clay-400/10 rounded-lg hover:border-sage-400/30 transition-colors";
      var legend = document.createElement("legend");
      legend.className = "font-medium text-clay-400 mb-4 px-1";
      legend.textContent = (qi + 1) + ". " + q;
      box.appendChild(legend);
      var list = document.createElement("div");
      list.className = "grid sm:grid-cols-2 gap-2";
      options.forEach(function (opt) {
        var label = document.createElement("label");
        label.className = "flex items-start gap-3 cursor-pointer p-3 hover:bg-warm-100 rounded transition-colors group";
        var input = document.createElement("input");
        input.type = "radio"; input.name = "q" + qi; input.value = String(opt.score);
        input.className = "mt-0.5 text-sage-500 focus:ring-sage-500 border-clay-400/30";
        var span = document.createElement("span");
        span.className = "text-clay-200 text-sm group-hover:text-clay-400";
        span.textContent = opt.text;
        label.appendChild(input); label.appendChild(span);
        list.appendChild(label);
      });
      box.appendChild(list);
      container.appendChild(box);
    });

    function describe(score) {
      if (score <= 4) return "Minimal düzeyde belirti. Belirgin bir depresif bulgu görünmüyor.";
      if (score <= 9) return "Hafif düzeyde depresif belirtiler. Belirtiler birkaç haftadan uzun sürerse bir uzmanla konuşmak faydalı olabilir.";
      if (score <= 14) return "Orta düzeyde depresif belirtiler. Bir ruh sağlığı uzmanıyla görüşmeniz önerilir.";
      if (score <= 19) return "Orta-şiddetli düzeyde depresif belirtiler. Yakın zamanda bir ruh sağlığı uzmanıyla görüşmeniz önerilir.";
      return "Şiddetli düzeyde depresif belirtiler. En kısa sürede bir ruh sağlığı uzmanıyla görüşmeniz önemlidir.";
    }

    document.getElementById("calcBtn").addEventListener("click", function () {
      var score = 0, missing = [], item9 = 0;
      for (var i = 0; i < questions.length; i++) {
        var sel = document.querySelector('input[name="q' + i + '"]:checked');
        if (!sel) { missing.push(i + 1); continue; }
        var v = parseInt(sel.value, 10);
        score += v;
        if (i === 8) item9 = v;
      }
      var err = document.getElementById("formError");
      if (missing.length) {
        err.textContent = "Lütfen tüm soruları yanıtlayın. Eksik: " + missing.join(", ");
        err.classList.remove("hidden");
        return;
      }
      err.classList.add("hidden");

      document.getElementById("scoreText").textContent = score;
      document.getElementById("resultDescription").textContent = describe(score);
      document.getElementById("safetyNote").classList.toggle("hidden", item9 === 0);
      var box = document.getElementById("resultContainer");
      box.classList.remove("hidden");
      box.scrollIntoView({ behavior: "smooth" });

      // Puan ve yanıtlar gönderilmez; yalnızca tamamlanma bilgisi (analitik izni varsa).
      if (typeof gtag === "function") gtag("event", "test_completed");
    });
  })();
</script>
